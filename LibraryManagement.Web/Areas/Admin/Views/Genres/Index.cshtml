@model AdminGenreListViewModel

@{
    ViewData["Title"] = "Kategori Yönetimi";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="mb-1">Kategori Yönetimi</h2>
        <p class="text-muted mb-0">Kitap kategorilerini listele, ekle, düzenle veya sil.</p>
    </div>
    <a asp-action="Create" class="btn btn-primary">Yeni Kategori</a>
</div>

@if (TempData["Message"] != null)
{
    <div class="alert alert-success">@TempData["Message"]</div>
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

<div class="table-responsive">
    <table class="table table-striped table-hover align-middle">
        <thead>
            <tr>
                <th>Id</th>
                <th>Kategori Adı</th>
                <th>Kitap Sayisi</th>
                <th class="text-end">Islemler</th>
            </tr>
        </thead>
        <tbody>
            @if (Model.Genres.Any())
            {
                foreach (var genre in Model.Genres)
                {
                    <tr>
                        <td>@genre.GenreId</td>
                        <td>@genre.Name</td>
                        <td>@genre.BookCount</td>
                        <td class="text-end">
                            <a asp-action="Details" asp-route-id="@genre.GenreId" class="btn btn-sm btn-outline-info">Detay</a>
                            <a asp-action="Edit" asp-route-id="@genre.GenreId" class="btn btn-sm btn-outline-warning">Düzenle</a>
                            <a asp-action="Delete" asp-route-id="@genre.GenreId" class="btn btn-sm btn-outline-danger">Sil</a>
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="4" class="text-center text-muted">Henüz kategori yok.</td>
                </tr>
            }
        </tbody>
    </table>
</div>
