@model AdminReviewFilterViewModel

@{
    ViewData["Title"] = "Yorum Yönetimi";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="mb-1">Yorum Yönetimi</h2>
        <p class="text-muted mb-0">Kitap yorumlarini goruntule ve gerekli olanlari sil.</p>
    </div>
    <a asp-area="Admin" asp-controller="Dashboard" asp-action="Index" class="btn btn-outline-secondary">Admin Panel</a>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

<div class="card mb-4">
    <div class="card-body">
        <form asp-action="Index" method="get">
            <div class="row g-3">
                <div class="col-md-3">
                    <label asp-for="BookSearch" class="form-label">Kitap Adı</label>
                    <input asp-for="BookSearch" class="form-control" />
                </div>
                <div class="col-md-3">
                    <label asp-for="UserSearch" class="form-label">Kullanıcı</label>
                    <input asp-for="UserSearch" class="form-control" placeholder="Kullanıcı adı veya e-posta" />
                </div>
                <div class="col-md-2">
                    <label asp-for="Rating" class="form-label">Puan</label>
                    <select asp-for="Rating" class="form-select">
                        <option value="">Tümü</option>
                        <option value="1">1</option>
                        <option value="2">2</option>
                        <option value="3">3</option>
                        <option value="4">4</option>
                        <option value="5">5</option>
                    </select>
                </div>
                <div class="col-md-2">
                    <label asp-for="Sort" class="form-label">Sıralama</label>
                    <select asp-for="Sort" class="form-select">
                        <option value="newest">En yeni</option>
                        <option value="oldest">En eski</option>
                    </select>
                </div>
                <div class="col-md-2 d-flex align-items-end gap-2">
                    <button type="submit" class="btn btn-primary">Filtrele</button>
                    <a asp-action="Index" class="btn btn-outline-secondary">Temizle</a>
                </div>
            </div>
        </form>
    </div>
</div>

<div class="table-responsive">
    <table class="table table-striped table-hover align-middle">
        <thead>
            <tr>
                <th>Yorum Id</th>
                <th>Kitap</th>
                <th>Kullanıcı</th>
                <th>Puan</th>
                <th>Yorum</th>
                <th>Tarih</th>
                <th class="text-end">Islemler</th>
            </tr>
        </thead>
        <tbody>
            @if (Model.Reviews.Any())
            {
                foreach (var review in Model.Reviews)
                {
                    var shortComment = review.Comment.Length > 80
                        ? review.Comment.Substring(0, 80) + "..."
                        : review.Comment;

                    <tr>
                        <td>@review.Id</td>
                        <td>@review.Book.Title</td>
                        <td>@review.User.Username <span class="text-muted small">(@review.User.Email)</span></td>
                        <td>
                            <span class="text-warning">
                                @for (var i = 1; i <= 5; i++)
                                {
                                    <span>@(i <= review.Rating ? "★" : "☆")</span>
                                }
                            </span>
                        </td>
                        <td>@shortComment</td>
                        <td>@review.CreatedAt.ToString("dd.MM.yyyy HH:mm")</td>
                        <td class="text-end">
                            <a asp-action="Details" asp-route-id="@review.Id" class="btn btn-sm btn-outline-info">Detay</a>
                            <a asp-action="Delete" asp-route-id="@review.Id" class="btn btn-sm btn-outline-danger">Sil</a>
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="7" class="text-center text-muted">Yorum bulunamadı.</td>
                </tr>
            }
        </tbody>
    </table>
</div>
