@model AdminBookListViewModel

@{
    ViewData["Title"] = "Kitap Yönetimi";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="mb-1">Kitap Yönetimi</h2>
        <p class="text-muted mb-0">Kitapları listele, ekle, düzenle veya sil.</p>
    </div>
    <a asp-action="Create" class="btn btn-primary">Yeni Kitap</a>
</div>

@if (TempData["Message"] != null)
{
    <div class="alert alert-success">@TempData["Message"]</div>
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

<div class="card mb-3">
    <div class="card-body">
        <form asp-action="Index" method="get" class="row g-2 align-items-end">
            <div class="col-md-4">
                <label for="stockFilter" class="form-label">Stok Durumu</label>
                <select asp-for="StockFilter" class="form-select">
                    <option value="">Tümü</option>
                    <option value="in_stock">Stokta olanlar</option>
                    <option value="low_stock">Düşük stok</option>
                    <option value="out_of_stock">Stokta olmayanlar</option>
                </select>
            </div>
            <div class="col-md-8 d-flex gap-2">
                <button type="submit" class="btn btn-primary">Filtrele</button>
                <a asp-action="Index" class="btn btn-outline-secondary">Temizle</a>
            </div>
        </form>
    </div>
</div>

<div class="table-responsive">
    <table class="table table-striped table-hover align-middle">
        <thead>
            <tr>
                <th>Id</th>
                <th>Görsel</th>
                <th>Kitap Adı</th>
                <th>Yazar</th>
                <th>Fiyat</th>
                <th>Stok</th>
                <th>Kategoriler</th>
                <th class="text-end">Islemler</th>
            </tr>
        </thead>
        <tbody>
            @if (Model.Books.Any())
            {
                foreach (var book in Model.Books)
                {
                    var stockStatus = book.Stock <= 0 ? "Stok yok" : book.Stock <= 5 ? "Düşük stok" : "Stok var";
                    var stockBadgeClass = book.Stock <= 0 ? "bg-danger" : book.Stock <= 5 ? "bg-warning text-dark" : "bg-success";
                    <tr>
                        <td>@book.BookId</td>
                        <td>
                            <img src="/img/@book.ImageUrl" alt="@book.Title" style="width:50px;height:70px;object-fit:cover;" />
                        </td>
                        <td>@book.Title</td>
                        <td>@book.Author</td>
                        <td>@book.Price.ToString("C")</td>
                        <td>
                            <span class="badge @stockBadgeClass">@stockStatus</span>
                            <span class="text-muted small ms-1">(@book.Stock)</span>
                        </td>
                        <td>
                            @if (book.Genres.Any())
                            {
                                @string.Join(", ", book.Genres.Select(g => g.Name))
                            }
                            else
                            {
                                <span class="text-muted">Kategori yok</span>
                            }
                        </td>
                        <td class="text-end">
                            <a asp-action="Details" asp-route-id="@book.BookId" class="btn btn-sm btn-outline-info">Detay</a>
                            <a asp-action="Edit" asp-route-id="@book.BookId" class="btn btn-sm btn-outline-warning">Düzenle</a>
                            <a asp-action="Delete" asp-route-id="@book.BookId" class="btn btn-sm btn-outline-danger">Sil</a>
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="8" class="text-center text-muted">Henüz kitap yok.</td>
                </tr>
            }
        </tbody>
    </table>
</div>
