@model AdminOrderDetailsViewModel

@{
    ViewData["Title"] = "Sipariş Detayı";
    var order = Model.Order;
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="mb-0">Sipariş Detayı</h2>
    <div>
        <a asp-action="Invoice" asp-route-orderId="@order.Id" class="btn btn-outline-primary me-2">PDF Fatura İndir</a>
        <a asp-action="Index" class="btn btn-outline-secondary">Listeye Dön</a>
    </div>
</div>

<div class="card mb-4">
    <div class="card-header fw-semibold">Sipariş Bilgileri</div>
    <div class="card-body">
        <dl class="row mb-0">
            <dt class="col-sm-3">Sipariş Id</dt>
            <dd class="col-sm-9">@order.Id</dd>

            <dt class="col-sm-3">Kullanıcı</dt>
            <dd class="col-sm-9">@order.UserId</dd>

            <dt class="col-sm-3">Sipariş Tarihi</dt>
            <dd class="col-sm-9">@order.OrderDate.ToString("dd.MM.yyyy HH:mm")</dd>

            <dt class="col-sm-3">Mevcut Durum</dt>
            <dd class="col-sm-9"><span class="badge bg-secondary">@order.Status</span></dd>

            <dt class="col-sm-3">Teslimat Adresi</dt>
            <dd class="col-sm-9">
                @if (order.Address == null)
                {
                    <span class="text-muted">Adres bilgisi yok</span>
                }
                else
                {
                    <strong>@order.Address.Title</strong><br />
                    <span>@order.Address.FullAddress</span><br />
                    <small>@order.Address.District / @order.Address.City @order.Address.ZipCode</small>
                }
            </dd>

            <dt class="col-sm-3">Ödeme Yöntemi</dt>
            <dd class="col-sm-9">@(string.IsNullOrWhiteSpace(order.PaymentMethod) ? "-" : order.PaymentMethod)</dd>

            <dt class="col-sm-3">Kupon Kodu</dt>
            <dd class="col-sm-9">@(string.IsNullOrWhiteSpace(order.CouponCode) ? "-" : order.CouponCode)</dd>

            <dt class="col-sm-3">Ara Toplam</dt>
            <dd class="col-sm-9">@order.TotalAmount.ToString("C")</dd>

            <dt class="col-sm-3">Kargo Ücreti</dt>
            <dd class="col-sm-9">@(order.ShippingFee == 0 ? "Ücretsiz" : order.ShippingFee.ToString("C"))</dd>

            <dt class="col-sm-3">İndirim Tutarı</dt>
            <dd class="col-sm-9">@(order.DiscountAmount == 0 ? "-" : "-" + order.DiscountAmount.ToString("C"))</dd>

            <dt class="col-sm-3">Genel Toplam</dt>
            <dd class="col-sm-9">@((order.GrandTotal == 0 ? order.TotalAmount : order.GrandTotal).ToString("C"))</dd>

            <dt class="col-sm-3">Kargo Şirketi</dt>
            <dd class="col-sm-9">@(string.IsNullOrWhiteSpace(order.CargoCompany) ? "-" : order.CargoCompany)</dd>

            <dt class="col-sm-3">Takip Numarası</dt>
            <dd class="col-sm-9">@(string.IsNullOrWhiteSpace(order.TrackingNumber) ? "-" : order.TrackingNumber)</dd>

            <dt class="col-sm-3">Kargoya Verildi</dt>
            <dd class="col-sm-9">@(order.ShippedAt?.ToString("dd.MM.yyyy HH:mm") ?? "-")</dd>

            <dt class="col-sm-3">Teslim Edildi</dt>
            <dd class="col-sm-9">@(order.DeliveredAt?.ToString("dd.MM.yyyy HH:mm") ?? "-")</dd>
        </dl>
    </div>
    <div class="card-footer">
        <a asp-action="EditStatus" asp-route-id="@order.Id" class="btn btn-warning">Durum Güncelle</a>
    </div>
</div>

<div class="card">
    <div class="card-header fw-semibold">Sipariş Ürünleri</div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-striped mb-0">
                <thead>
                    <tr>
                        <th>Kitap Adı</th>
                        <th>Adet</th>
                        <th>Birim Fiyat</th>
                        <th>Toplam Fiyat</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in order.Items)
                    {
                        <tr>
                            <td>@item.Title</td>
                            <td>@item.Quantity</td>
                            <td>@item.Price.ToString("C")</td>
                            <td>@item.TotalPrice.ToString("C")</td>
                        </tr>
                    }
                </tbody>
                <tfoot>
                    <tr>
                        <td colspan="3" class="text-end fw-semibold">Ara Toplam</td>
                        <td class="fw-semibold">@order.TotalAmount.ToString("C")</td>
                    </tr>
                    <tr>
                        <td colspan="3" class="text-end fw-semibold">Kargo Ücreti</td>
                        <td class="fw-semibold">@(order.ShippingFee == 0 ? "Ücretsiz" : order.ShippingFee.ToString("C"))</td>
                    </tr>
                    <tr>
                        <td colspan="3" class="text-end fw-semibold">İndirim</td>
                        <td class="fw-semibold">@(order.DiscountAmount == 0 ? "-" : "-" + order.DiscountAmount.ToString("C"))</td>
                    </tr>
                    <tr>
                        <td colspan="3" class="text-end fw-semibold">Genel Toplam</td>
                        <td class="fw-semibold">@((order.GrandTotal == 0 ? order.TotalAmount : order.GrandTotal).ToString("C"))</td>
                    </tr>
                </tfoot>
            </table>
        </div>
    </div>
</div>
