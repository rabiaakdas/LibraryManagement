@model LibraryManagement.Web.Models.CheckoutViewModel

@{
    ViewData["Title"] = "Sipariş Tamamla";
}

<h2 class="mb-4">Sipariş Tamamla</h2>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}

<form asp-action="Checkout" method="post">
    @Html.AntiForgeryToken()
    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

    <div class="row g-4">
        <div class="col-lg-8">
            <div class="card mb-4">
                <div class="card-header fw-semibold">Teslimat Adresi</div>
                <div class="card-body">
                    @if (!Model.Addresses.Any())
                    {
                        <div class="alert alert-warning mb-0">
                            Kayıtlı adresiniz bulunmuyor.
                            <a asp-controller="Profiles" asp-action="CreateAddress" class="alert-link">Adres ekle</a>
                        </div>
                    }
                    else
                    {
                        foreach (var address in Model.Addresses)
                        {
                            <div class="form-check border rounded p-3 mb-2">
                                <input class="form-check-input ms-0 me-2" type="radio" asp-for="AddressId" value="@address.Id" id="address_@address.Id" />
                                <label class="form-check-label" for="address_@address.Id">
                                    <strong>@address.Title</strong><br />
                                    <span>@address.FullAddress</span><br />
                                    <small class="text-muted">@address.District / @address.City @address.ZipCode</small>
                                </label>
                            </div>
                        }
                        <span asp-validation-for="AddressId" class="text-danger"></span>
                        <div class="mt-3">
                            <a asp-controller="Profiles" asp-action="CreateAddress" class="btn btn-outline-primary btn-sm">Yeni Adres Ekle</a>
                        </div>
                    }
                </div>
            </div>

            <div class="card mb-4">
                <div class="card-header fw-semibold">Ödeme Yöntemi</div>
                <div class="card-body">
                    <div class="form-check">
                        <input class="form-check-input payment-method" type="radio" asp-for="PaymentMethod" value="Kapıda ödeme" id="paymentCash" />
                        <label class="form-check-label" for="paymentCash">Kapıda ödeme</label>
                    </div>
                    <div class="form-check">
                        <input class="form-check-input payment-method" type="radio" asp-for="PaymentMethod" value="Kredi kartı simülasyonu" id="paymentCard" />
                        <label class="form-check-label" for="paymentCard">Kredi kartı simülasyonu</label>
                    </div>
                    <div class="form-check mb-2">
                        <input class="form-check-input payment-method" type="radio" asp-for="PaymentMethod" value="Havale/EFT" id="paymentTransfer" />
                        <label class="form-check-label" for="paymentTransfer">Havale/EFT</label>
                    </div>
                    <span asp-validation-for="PaymentMethod" class="text-danger"></span>

                    <div id="cardFields" class="border rounded p-3 mt-3" style="display:none;">
                        <div class="mb-3">
                            <label asp-for="CardHolderName" class="form-label">Kart Sahibi</label>
                            <input asp-for="CardHolderName" class="form-control" autocomplete="off" />
                            <span asp-validation-for="CardHolderName" class="text-danger"></span>
                        </div>
                        <div class="mb-3">
                            <label asp-for="CardNumber" class="form-label">Kart Numarası</label>
                            <input asp-for="CardNumber" class="form-control" maxlength="16" autocomplete="off" />
                            <span asp-validation-for="CardNumber" class="text-danger"></span>
                        </div>
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="ExpirationDate" class="form-label">Son Kullanma Tarihi</label>
                                <input asp-for="ExpirationDate" class="form-control" placeholder="AA/YY" autocomplete="off" />
                                <span asp-validation-for="ExpirationDate" class="text-danger"></span>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label asp-for="Cvv" class="form-label">CVV</label>
                                <input asp-for="Cvv" class="form-control" maxlength="4" autocomplete="off" />
                                <span asp-validation-for="Cvv" class="text-danger"></span>
                            </div>
                        </div>
                        <div class="form-text">Kart bilgileri sadece doğrulama için kullanılır, veritabanına kaydedilmez.</div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-4">
            <div class="card">
                <div class="card-header fw-semibold">Sipariş Özeti</div>
                <div class="card-body">
                    @foreach (var item in Model.CartItems)
                    {
                        <div class="d-flex justify-content-between border-bottom py-2">
                            <div>
                                <div class="fw-semibold">@item.Title</div>
                                <small class="text-muted">@item.Quantity adet</small>
                            </div>
                            <span>@item.TotalPrice.ToString("C")</span>
                        </div>
                    }

                    <div class="d-flex justify-content-between mt-3">
                        <span>Ara Toplam</span>
                        <strong>@Model.SubTotal.ToString("C")</strong>
                    </div>
                    <div class="d-flex justify-content-between mt-2">
                        <span>Kargo Ücreti</span>
                        <strong>@(Model.ShippingFee == 0 ? "Ücretsiz" : Model.ShippingFee.ToString("C"))</strong>
                    </div>
                    <div class="mt-3">
                        <label asp-for="CouponCode" class="form-label">Kupon Kodu</label>
                        <div class="input-group">
                            <input asp-for="CouponCode" class="form-control" />
                            <button type="submit" asp-action="ApplyCoupon" class="btn btn-outline-primary">Kupon Uygula</button>
                        </div>
                        <span asp-validation-for="CouponCode" class="text-danger"></span>
                    </div>
                    @if (Model.DiscountAmount > 0)
                    {
                        <div class="d-flex justify-content-between mt-3 text-success">
                            <span>İndirim (@Model.CouponCode)</span>
                            <strong>-@Model.DiscountAmount.ToString("C")</strong>
                        </div>
                    }
                    <hr />
                    <div class="d-flex justify-content-between fs-5">
                        <span>Genel Toplam</span>
                        <strong>@Model.GrandTotal.ToString("C")</strong>
                    </div>

                    <button type="submit" class="btn btn-success w-100 mt-4" disabled="@(!Model.Addresses.Any())">
                        Siparişi Tamamla
                    </button>
                    <a asp-action="Index" class="btn btn-outline-secondary w-100 mt-2">Sepete Dön</a>
                </div>
            </div>
        </div>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        function toggleCardFields() {
            const selected = document.querySelector('input[name="PaymentMethod"]:checked');
            const cardFields = document.getElementById('cardFields');
            cardFields.style.display = selected && selected.value === 'Kredi kartı simülasyonu' ? 'block' : 'none';
        }

        document.querySelectorAll('.payment-method').forEach(function (input) {
            input.addEventListener('change', toggleCardFields);
        });

        toggleCardFields();
    </script>
}
