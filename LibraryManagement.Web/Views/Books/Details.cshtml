@model BookDetailsViewModel

@{
    var book = Model.Book;
}

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

<div class="card mb-4">
    <div class="row g-0">
        <div class="col-md-3">
            <img src="/img/@book.ImageUrl" alt="@book.Title" class="img-fluid rounded-start" style="height:320px;width:100%;object-fit:cover;" />
        </div>
        <div class="col-md-9">
            <div class="card-body">
                <h2 class="h4 card-title">@book.Title</h2>
                <p class="card-text"><strong>Yazar:</strong> @book.Author</p>
                <p class="card-text"><strong>Sayfa Sayisi:</strong> @book.PageCount</p>
                <p class="card-text"><strong>Fiyat:</strong> @book.Price.ToString("C")</p>
                <p class="card-text">
                    <strong>Stok:</strong>
                    <span class="badge @(book.Stock <= 0 ? "bg-danger" : book.Stock <= 5 ? "bg-warning text-dark" : "bg-success")">
                        @(book.Stock <= 0 ? "Stokta Yok" : book.Stock <= 5 ? $"Düşük Stok: {book.Stock}" : $"Stok: {book.Stock}")
                    </span>
                </p>

                <div class="mb-3">
                    <strong>Ortalama Puan:</strong>
                    <span class="text-warning">
                        @for (var i = 1; i <= 5; i++)
                        {
                            <span>@(i <= Math.Round(Model.AverageRating) ? "★" : "☆")</span>
                        }
                    </span>
                    <span class="text-muted">
                        @(Model.ReviewCount > 0 ? Model.AverageRating.ToString("0.0") : "0.0") / 5
                        (@Model.ReviewCount yorum)
                    </span>
                </div>

                <div class="d-flex gap-2">
                    <form asp-controller="Cart" asp-action="UpdateQuantity" method="post">
                        <input type="hidden" name="BookId" value="@book.BookId" />
                        <input type="hidden" name="quantity" value="1" />
                        <button type="submit" class="btn btn-outline-secondary" disabled="@(book.Stock <= 0)">
                            @(book.Stock <= 0 ? "Stokta Yok" : "Sepete Ekle")
                        </button>
                    </form>
                    <button type="button" class="btn btn-link p-0 add-to-favorites" data-id="@book.BookId">
                        <i class="bi bi-heart" style="font-size:1.6rem; color:red;"></i>
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="card mb-4">
    <div class="card-header">
        <h3 class="h5 mb-0">Yorumlar</h3>
    </div>
    <div class="card-body">
        @if (User.Identity?.IsAuthenticated == true)
        {
            if (Model.CanReview)
            {
                <form asp-action="AddReview" method="post" class="mb-4">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="NewReview.BookId" name="BookId" />

                    <div class="mb-3">
                        <label asp-for="NewReview.Rating" class="form-label">Puan</label>
                        <select asp-for="NewReview.Rating" name="Rating" class="form-select" style="max-width:220px;">
                            <option value="5">5 - Çok iyi</option>
                            <option value="4">4 - Iyi</option>
                            <option value="3">3 - Orta</option>
                            <option value="2">2 - Zayif</option>
                            <option value="1">1 - Kotu</option>
                        </select>
                    </div>

                    <div class="mb-3">
                        <label asp-for="NewReview.Comment" class="form-label">Yorum</label>
                        <textarea asp-for="NewReview.Comment" name="Comment" class="form-control" rows="3" maxlength="500"></textarea>
                    </div>

                    <button type="submit" class="btn btn-primary">Yorum Ekle</button>
                </form>
            }
            else if (Model.HasReviewed)
            {
                <div class="alert alert-info">Bu kitap için zaten yorum yaptınız.</div>
            }
        }
        else
        {
            <div class="alert alert-warning">
                Yorum yapmak için giriş yapmalısınız.
            </div>
        }

        @if (Model.Reviews.Any())
        {
            foreach (var review in Model.Reviews)
            {
                <div class="border-top pt-3 mt-3">
                    <div class="d-flex justify-content-between">
                        <strong>@review.User.Username</strong>
                        <span class="text-muted">@review.CreatedAt.ToString("dd.MM.yyyy HH:mm")</span>
                    </div>
                    <div class="text-warning mb-2">
                        @for (var i = 1; i <= 5; i++)
                        {
                            <span>@(i <= review.Rating ? "★" : "☆")</span>
                        }
                    </div>
                    <p class="mb-0">@review.Comment</p>
                </div>
            }
        }
        else
        {
            <p class="text-muted mb-0">Bu kitap icin henuz yorum yapilmamis.</p>
        }
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
